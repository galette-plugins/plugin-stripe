msgstr "Tukaj vnesite svoj javni ključ Stripe."

#: ../templates/default/stripe_preferences.html.twig:44
msgid "Stripe secret key"
msgstr "Tajni ključ Stripe"

#: ../templates/default/stripe_preferences.html.twig:51

msgstr "Med nalaganjem nastavitev iz baze podatkov je prišlo do napake."

#: ../templates/default/stripe_preferences.html.twig:20
msgid "Please, check if the plugin's database has been properly initialized."
msgstr ""
"Prosim, preverite, ali je bila baza podatkov vtičnika pravilno "
"inicializirana."

#: ../templates/default/stripe_preferences.html.twig:28

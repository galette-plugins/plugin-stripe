#: ../lib/GaletteStripe/Controllers/StripeController.php:62
msgid "Online payment"
msgstr "Spletno plačilo"

#: ../lib/GaletteStripe/Controllers/StripeController.php:70
msgid ""
"<strong>Payment could not work</strong>: An error occurred (that has been "
"logged) while loading Stripe settings from the database.<br/>Please report "
"the issue to the staff."
msgstr ""
"<strong>Plačilo ni delovalo</strong>: Med nalaganjem nastavitev Stripe iz "
"baze podatkov je prišlo do napake (ki je bila zabeležena).<br/>Prosimo, da "
"težavo prijavite osebju."

#: ../lib/GaletteStripe/Controllers/StripeController.php:71
msgid "Our apologies for the annoyance."
msgstr "Opravičujemo se za motnjo."

#: ../lib/GaletteStripe/Controllers/StripeController.php:78
msgid ""
"Stripe keys have not been defined. Please ask an administrator to add them "
"in the plugin's settings."
msgstr ""
"Črtasti ključi niso definirani. Prosite skrbnika, da jih doda v nastavitvah "
"vtičnika."

#: ../lib/GaletteStripe/Controllers/StripeController.php:109
#: ../templates/default/stripe_form.html.twig:85
msgid "You have to select an option."
msgstr "Izbrati morate možnost."

#: ../lib/GaletteStripe/Controllers/StripeController.php:123
#: ../templates/default/stripe_form.html.twig:91
msgid "Please enter an amount."
msgstr "Vnesite znesek."

#: ../lib/GaletteStripe/Controllers/StripeController.php:135
#: ../templates/default/stripe_form.html.twig:94
msgid ""
"The amount you've entered is lower than the minimum amount for the selected "
"option. Please choose another option or change the amount."
msgstr ""
"Znesek, ki ste ga vnesli, je nižji od minimalnega zneska za izbrano možnost. "
"Izberite drugo možnost ali spremenite znesek."

#: ../lib/GaletteStripe/Controllers/StripeController.php:157
msgid "An error occurred loading the checkout form."
msgstr "Pri nalaganju obrazca za odjavo je prišlo do napake."

#: ../lib/GaletteStripe/Controllers/StripeController.php:221
